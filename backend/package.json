{
  "name": "tenfold-backend",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "dev": "node node_modules/ts-node-dev/lib/bin.js --files --respawn src/index.ts",
    "test": "node node_modules/vitest/vitest.mjs run tests/session.test.ts tests/round.test.ts",
    "test:integration": "node node_modules/vitest/vitest.mjs run tests/integration.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
